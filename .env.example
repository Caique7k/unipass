# Docker Compose / deploy
COMPOSE_PROJECT_NAME=unipass
COMPOSE_PROFILES=proxy
NODE_ENV=production

POSTGRES_USER=unipass
POSTGRES_PASSWORD=troque-esta-senha-do-postgres
POSTGRES_DB=unipass_db
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432

REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_PASSWORD=troque-esta-senha-do-redis

BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
BACKEND_HOST_BIND=127.0.0.1
BACKEND_HOST_PORT=4000
APP_TIMEZONE=America/Sao_Paulo
REDIS_URL_DOCKER=redis://:troque-esta-senha-do-redis@redis:6379/0
DATABASE_URL_DOCKER=postgresql://unipass:troque-esta-senha-do-postgres@postgres:5432/unipass_db
PRISMA_GENERATE_DATABASE_URL=postgresql://placeholder:placeholder@postgres:5432/unipass_db

FRONTEND_HOSTNAME=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_HOST_BIND=127.0.0.1
FRONTEND_HOST_PORT=3000

APP_DOMAIN=app.seu-dominio.com
API_DOMAIN=api.seu-dominio.com
CADDY_ACME_EMAIL=infra@seu-dominio.com
PROXY_HOST_BIND=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

NEXT_PUBLIC_API_URL=https://api.seu-dominio.com
NEXT_PUBLIC_ANDROID_APP_URL=https://expo.dev/artifacts/eas/d3DFFq5EMswNioqQDbL3X8.apk
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/br/app/seu-app/id0000000000
