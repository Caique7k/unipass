PORT=4000
HOST=0.0.0.0
TRUST_PROXY=0

DATABASE_URL=postgresql://unipass:troque-esta-senha-do-postgres@localhost:5432/unipass_db

JWT_SECRET=troque-este-jwt-secret-com-pelo-menos-32-caracteres
JWT_EXPIRES=1h

FRONTEND_URLS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_REMEMBER_MAX_AGE_MS=2592000000

DEVICE_API_KEY=troque-esta-device-api-key-com-pelo-menos-24-caracteres

APP_TIMEZONE=America/Sao_Paulo
REDIS_URL=redis://:troque-esta-senha-do-redis@127.0.0.1:6379/0
NOTIFICATION_WORKER_CONCURRENCY=10
BILLING_WEBHOOK_WORKER_CONCURRENCY=5
BILLING_WEBHOOK_PENDING_AGE_SECONDS=60
BILLING_WEBHOOK_RETRY_BATCH_SIZE=50
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_IP_WHITELIST=
ASAAS_WEBHOOK_HMAC_SECRET=
ASAAS_WEBHOOK_SIGNATURE_HEADER=asaas-signature
ASAAS_WEBHOOK_HMAC_ALGORITHM=sha256

